@model Blogy.Business.Dtos.BlogDtos.CreateBlogDto

@{
    ViewData["Title"] = "AI Makale Stüdyosu";
    Layout = "_PanelLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">
            <i class="bi bi-magic text-warning me-2"></i>AI Makale Stüdyosu
        </h3>
        <p class="text-muted small mb-0">Gemini 3.5 Flash ile tek tıkla en az 1000 karakterlik zengin blog yazıları oluşturun, düzenleyin ve yayınlayın.</p>
    </div>
    <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-journal-text me-1"></i> Blog Listesine Git
    </a>
</div>

<div class="card border-0 shadow-sm rounded-3 mb-4" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);">
    <div class="card-body p-4">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 class="text-white fw-bold mb-0">
                <i class="bi bi-robot text-warning me-2"></i>Makale Tasarımcısı
            </h5>
            <span class="badge bg-warning text-dark px-3 py-1 fw-bold">Min. 1000 Karakter</span>
        </div>
        <p class="text-light opacity-75 small mb-4">
            Aşağıya istediğiniz konunun anahtar kelimelerini ve detaylarını yazın. Yapay zeka başlığı, makale metnini, etiketleri ve en uygun kategoriyi otomatik hazırlayacaktır.
        </p>

        <div class="row g-3">
            <div class="col-md-5">
                <label class="form-label text-white small fw-semibold">Anahtar Kelimeler <span class="text-warning">*</span></label>
                <input type="text" id="aiKeywords" class="form-control" placeholder="Örn: C#, ASP.NET Core, Clean Architecture, Microservices" />
            </div>
            <div class="col-md-7">
                <label class="form-label text-white small fw-semibold">Konu Özeti & Özel Talimatınız <span class="text-warning">*</span></label>
                <input type="text" id="aiTopic" class="form-control" placeholder="Örn: 2026'da kurumsal backend mimarilerinin önemini anlatan akıcı ve teknik bir rehber olsun." />
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-4 pt-2 border-top border-secondary">
            <span id="aiStatusText" class="text-warning small fw-semibold"></span>
            <button type="button" id="btnGenerate" class="btn btn-warning px-4 py-2 fw-bold d-flex align-items-center gap-2">
                <span id="aiSpinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                <i class="bi bi-stars" id="aiIcon"></i> Makaleyi Tasarla
            </button>
        </div>
    </div>
</div>

<div id="publishSection" class="d-none">
    <div class="alert alert-success d-flex align-items-center justify-content-between py-3 mb-4 shadow-sm border-0">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill fs-4 text-success"></i>
            <div>
                <strong class="d-block">Makale Başarıyla Hazırlandı!</strong>
                <span class="small text-muted" id="charCountSummary">İçeriği aşağıdan inceleyebilir, dilediğiniz gibi düzenleyebilir ve yayınlayabilirsiniz.</span>
            </div>
        </div>
    </div>

    <form asp-area="Admin" asp-controller="AiArticle" asp-action="PublishBlog" method="post" enctype="multipart/form-data">
        <div class="row g-4">

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="card-title mb-0 fw-bold text-dark">
                            <i class="bi bi-file-earmark-text text-primary me-2"></i>Blog İçerik Detayları
                        </h6>
                        <span id="charCountBadge" class="badge bg-light text-dark border">0 Karakter</span>
                    </div>
                    <div class="card-body p-4">

                        <div class="mb-4">
                            <label asp-for="Title" class="form-label fw-bold text-secondary">Blog Başlığı <span class="text-danger">*</span></label>
                            <input type="text" asp-for="Title" id="blogTitleInput" class="form-control form-control-lg fw-semibold" required />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold text-secondary">Makale Metni <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" id="blogDescriptionInput" class="form-control" rows="14" style="line-height: 1.8;" required></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">

                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="card-title mb-0 fw-semibold text-dark">
                            <i class="bi bi-tag text-primary me-1"></i> Kategori
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <label asp-for="CategoryId" class="form-label fw-semibold small text-secondary">Yazının Kategorisi</label>
                        <select asp-for="CategoryId" id="categorySelect" asp-items="@ViewBag.Categories" class="form-select" required></select>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="card-title mb-0 fw-semibold text-dark">
                            <i class="bi bi-tags text-primary me-1"></i> Etiketler (Tags)
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <label asp-for="Tags" class="form-label fw-semibold small text-secondary">Etiketler</label>
                        <input type="text" asp-for="Tags" id="blogTagsInput" class="form-control" />
                        <div class="form-text text-muted small">Etiketleri virgülle (,) ayırabilirsiniz.</div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="card-title mb-0 fw-semibold text-dark">
                            <i class="bi bi-image text-primary me-1"></i> Kapak Görseli
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <input type="file" name="coverImageFile" class="form-control form-control-sm" accept="image/*" />
                        <div class="form-text text-muted small">Seçmezseniz varsayılan şık bir görsel atanacaktır.</div>
                    </div>
                </div>

                <div class="card shadow-sm border-0 rounded-3 bg-light">
                    <div class="card-body p-3 text-center">
                        <button type="submit" class="btn btn-success w-100 py-3 fw-bold fs-6 d-flex align-items-center justify-content-center gap-2 mb-2 shadow-sm">
                            <i class="bi bi-send-check-fill"></i> Blog Olarak Yayınla
                        </button>
                        <small class="text-muted">Doğrudan veritabanına kaydedilir ve sitede yayına girer.</small>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $("#btnGenerate").click(function () {
                const keywords = $("#aiKeywords").val().trim();
                const topic = $("#aiTopic").val().trim();

                if (!keywords || !topic) {
                    Swal.fire('Eksik Bilgi', 'Lütfen hem anahtar kelimeleri hem de konu özetini giriniz.', 'warning');
                    return;
                }

                const $btn = $("#btnGenerate");
                $btn.prop("disabled", true);
                $("#aiSpinner").removeClass("d-none");
                $("#aiIcon").addClass("d-none");
                $("#aiStatusText").text("Gemini AI makaleyi, başlığı ve etiketleri hazırlıyor (lütfen bekleyin)...");

                $.ajax({
                    url: '/Admin/AiArticle/Generate',
                    type: 'POST',
                    data: { keywords: keywords, summaryPrompt: topic },
                    success: function (response) {
                        if (response.success) {
                            // Form elemanlarını doldur:
                            $("#blogTitleInput").val(response.title);
                            $("#blogDescriptionInput").val(response.content);
                            $("#blogTagsInput").val(response.tags);

                            // Kategoriyi otomatik eşle ve seç:
                            if (response.suggestedCategory) {
                                const targetCat = response.suggestedCategory.trim().toLowerCase();
                                $("#categorySelect option").each(function () {
                                    if ($(this).text().trim().toLowerCase() === targetCat) {
                                        $(this).prop('selected', true);
                                    }
                                });
                            }

                            // Karakter sayısını güncelle:
                            const charCount = response.content ? response.content.length : 0;
                            $("#charCountBadge").text(`${charCount} Karakter`);
                            $("#charCountSummary").text(`${charCount} karakter uzunluğunda profesyonel makale oluşturuldu.`);

                            // Önizleme bölümünü aç ve oraya kaydır:
                            $("#publishSection").removeClass("d-none");
                            $('html, body').animate({
                                scrollTop: $("#publishSection").offset().top - 20
                            }, 500);

                            Swal.fire({
                                icon: 'success',
                                title: 'Makale Tasarlandı!',
                                html: `<b>Başlık:</b> ${response.title}<br><b>Karakter:</b> ${charCount} Karakter<br>Aşağıdaki formdan inceleyip <b>Blog Olarak Yayınla</b> butonuna basabilirsiniz!`,
                                confirmButtonText: 'İncele'
                            });

                            $("#aiStatusText").html(`<i class="bi bi-check-circle-fill text-success"></i> Makale hazırlandı!`);
                        } else {
                            Swal.fire('Hata', response.message, 'error');
                            $("#aiStatusText").text("");
                        }
                    },
                    error: function () {
                        Swal.fire('Hata', 'Yapay zeka yanıt üretirken bir sorun oluştu.', 'error');
                        $("#aiStatusText").text("");
                    },
                    complete: function () {
                        $btn.prop("disabled", false);
                        $("#aiSpinner").addClass("d-none");
                        $("#aiIcon").removeClass("d-none");
                    }
                });
            });

            // Kullanıcı metin üzerinde elle değişiklik yaptıkça karakter sayısını canlı güncelle:
            $("#blogDescriptionInput").on('input', function () {
                const len = $(this).val().length;
                $("#charCountBadge").text(`${len} Karakter`);
            });
        });
    </script>
}
