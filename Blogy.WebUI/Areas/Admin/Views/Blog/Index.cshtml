@model List<ResultBlogDto>

@{
    ViewData["Title"] = "Bloglar";
    Layout = "_Layout";
    int count = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Bloglar</h2>

    <a asp-area="Admin"
       asp-controller="Blog"
       asp-action="Create"
       class="btn btn-primary">
        Yeni Blog Oluştur
    </a>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Görsel</th>
                <th>Blog Başlığı</th>
                <th>Açıklama</th>
                <th>Kategori</th>
                <th>İşlemler</th>
            </tr>
        </thead>

        <tbody>
            @foreach(var item in Model)
            {
                count++;
                <tr>
                    <td>@count</td>

                    <td>
                        <img src="@item.CoverImage"
                             alt="@item.Title"
                             class="img-thumbnail"
                             width="75"
                             height="75"/>
                    </td>

                    <td class="fw-semibold">
                        @item.Title
                    </td>

                    <td>
                        @(item.Description.Length > 100 ? item.Description.Substring(0,100) + "..." : item.Description)
                    </td>

                    <td class="align-middle">
                        <span class="badge bg-secondary d-block w-100 text-center py-1">
                            @item.CategoryName
                        </span>
                    </td>

                    <td>
                        <div class="d-flex gap-2">
                            <a asp-area="Admin"
                               asp-controller="Blog"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning flex-fill">
                                Düzenle
                            </a>

                            <form asp-area="Admin"
                                  asp-controller="Blog"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="flex-fill"
                                  onsubmit="return confirm('Bu blogu silmek istediğinize emin misiniz?');">

                                <button type="submit"
                                        class="btn btn-sm btn-danger w-100">
                                    Sil
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>