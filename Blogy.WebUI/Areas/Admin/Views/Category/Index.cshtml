@model List<ResultCategoryDto>

@{
    ViewBag.Title = "title";
    Layout = "_Layout";
    int count = 0;
}

<h2>Kategoriler</h2>

<table class="table table-bordered table-hover">
    <tr>
        <th>#</th>
        <th>Kategori Adı</th>
        <th>İşlemler</th>
    </tr>
    @foreach (var item in Model)
    {
        count++;
        <tr>
            <td>@count</td>
            <td>@item.Name</td>
            <td>
                <a asp-area="Admin" asp-controller="Category" asp-action="Delete" asp-route-id="@item.Id"  class="btn btn-danger">Sil</a>
                <a asp-area="Admin" asp-controller="Category" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning">Düzenle</a>
            </td>
        </tr>
    }

</table>

<a asp-area="Admin" asp-controller="Category" asp-action="Create" class="btn btn-primary">Yeni Kategori Oluştur</a>
