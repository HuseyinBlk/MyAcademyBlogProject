@model CreateCommentDto

@{
    ViewData["Title"] = "Yeni Yorum Ekle";
    Layout = "_Layout";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-7 col-md-9">
        <div class="card shadow-sm border-0">
            <!-- Kart Başlığı -->
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h4 class="card-title mb-0 fw-bold">Yeni Yorum Ekle</h4>
                <span class="badge bg-light text-muted border">Admin Paneli</span>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <!-- Hata Mesajları Özeti -->
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                    <!-- Bilgilendirme Kutusu -->
                    <div class="alert alert-info border-0 d-flex align-items-center gap-2 mb-4 py-2">
                        <i class="bi bi-info-circle-fill fs-5"></i>
                        <span class="small">
                            Yorum, şu an giriş yapmış olan <strong>@@@User.Identity.Name</strong> kullanıcısı adına kaydedilecektir.
                        </span>
                    </div>

                    <!-- 1. İlgili Blog Seçimi -->
                    <div class="mb-3">
                        <label asp-for="BlogId" class="form-label fw-semibold">Yorum Yapılacak Blog</label>
                        <select asp-for="BlogId" 
                                asp-items="@ViewBag.Blogs" 
                                class="form-select" 
                                required>
                            <option value="" disabled selected>-- Lütfen Bir Blog Seçin --</option>
                        </select>
                        <span asp-validation-for="BlogId" class="text-danger small"></span>
                    </div>

                    <!-- 2. Yorum İçeriği -->
                    <div class="mb-4">
                        <label asp-for="Content" class="form-label fw-semibold">Yorum Metni</label>
                        <textarea asp-for="Content" 
                                  class="form-control" 
                                  rows="6" 
                                  placeholder="Yorumunuzu buraya yazın..." 
                                  required></textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                        <div class="form-text text-muted">
                            Lütfen hakaret ve argo içermeyen, yapıcı bir yorum yazın.
                        </div>
                    </div>

                    <!-- Butonlar -->
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-area="Admin" 
                           asp-controller="Comment" 
                           asp-action="Index" 
                           class="btn btn-outline-secondary px-4">
                            Vazgeç
                        </a>

                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-send-fill me-1"></i> Yorumu Yayınla
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>