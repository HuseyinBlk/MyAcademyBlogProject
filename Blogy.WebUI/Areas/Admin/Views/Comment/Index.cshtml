@model List<ResultCommentDto>

@{
    ViewData["Title"] = "Yorumlar";
    Layout = "_Layout";
}

<!-- Üst Başlık Bilgisi ve Yeni Yorum Ekle Butonu -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Yorum Listesi</h2>
        <p class="text-muted small mb-0">Blog yazılarına gelen tüm kullanıcı yorumlarını buradan yönetebilirsiniz.</p>
    </div>

    <a asp-area="Admin" asp-controller="Comment" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-chat-left-text-fill"></i>
        <span>Yeni Yorum Ekle</span>
    </a>
</div>

<!-- Yorumlar Tablosu -->
<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 60px;" class="text-center">#</th>
                        <th style="width: 220px;">Kullanıcı</th>
                        <th style="width: 220px;">İlgili Blog</th>
                        <th>Yorum İçeriği</th>
                        <th style="width: 130px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-secondary"></i>
                                Henüz hiçbir blog yazısına yorum yapılmamış.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var comment = Model[index];

                            <tr>
                                <!-- 1. Sıra Numarası -->
                                <td class="text-center fw-bold text-muted">
                                    @(index + 1)
                                </td>

                                <!-- 2. Yorum Yapan Kullanıcı -->
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center overflow-hidden"
                                             style="width: 38px; height: 38px; min-width: 38px;">
                                            @if (!string.IsNullOrEmpty(comment.User?.ProfilImageUrl))
                                            {
                                                <img src="@comment.User.ProfilImageUrl" alt="@comment.User.FullName" class="w-100 h-100 object-fit-cover" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark small">
                                                @(comment.User?.FullName ?? "Anonim Kullanıcı")
                                            </div>
                                            <span class="text-muted" style="font-size: 0.75rem;">
                                                @@@(comment.User?.UserName ?? "kullanici")
                                            </span>
                                        </div>
                                    </div>
                                </td>

                                <!-- 3. İlgili Blog Başlığı -->
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1 text-wrap text-start"
                                          style="max-width: 200px; display: inline-block;">
                                        <i class="bi bi-journal-text me-1"></i>
                                        @(comment.Blog?.Title ?? $"Blog #{comment.BlogId}")
                                    </span>
                                </td>

                                <!-- 4. Yorum Metni -->
                                <td>
                                    <p class="mb-0 text-secondary text-break" style="font-size: 0.9rem;">
                                        @comment.Content
                                    </p>
                                </td>

                                <!-- 5. İşlemler -->
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <!-- Sil Butonu -->
                                        <form asp-area="Admin"
                                              asp-controller="Comment"
                                              asp-action="Delete"
                                              asp-route-id="@comment.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu yorumu silmek istediğinize emin misiniz?');">
                                            
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Yorumu Sil">
                                                <i class="bi bi-trash3"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>