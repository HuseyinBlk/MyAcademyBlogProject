@model Blogy.WebUI.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_PanelLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Genel Bakış & İstatistikler</h3>
        <p class="text-muted small mb-0">Platformunuzun anlık verilerini, yapay zeka analizlerini ve grafiklerini buradan izleyin.</p>
    </div>
    <div class="text-end">
        <span class="badge bg-primary px-3 py-2">
            <i class="bi bi-clock me-1"></i> @DateTime.Now.ToString("dd MMMM yyyy, dddd")
        </span>
    </div>
</div>

<div class="row g-3 mb-4">

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary-subtle text-primary p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-journal-richtext fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Toplam Blog</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalBlogCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-info-subtle text-info p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-tags fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Kategoriler</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalCategoryCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning-subtle text-warning p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-chat-left-dots fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Toplam Yorum</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalCommentCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger-subtle text-danger p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-shield-x fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Toksik Yorum</div>
                    <div class="fs-4 fw-bold text-danger">@Model.ToxicCommentCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success-subtle text-success p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-pen fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Yazarlar</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalWriterCount</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-2 col-md-4 col-sm-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-body p-3 d-flex align-items-center gap-3">
                <div class="rounded-3 bg-dark-subtle text-dark p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                    <i class="bi bi-people fs-4"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold">Toplam Üye</div>
                    <div class="fs-4 fw-bold text-dark">@Model.TotalUserCount</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-pie-chart-fill text-primary me-2"></i>Kategori Bazlı Blog Dağılımı
                </h6>
                <span class="badge bg-light text-secondary border">Chart.js</span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center" style="min-height: 320px;">
                <canvas id="categoryChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-shield-check text-success me-2"></i>Yorum Sağlığı & Toksiklik Oranı (NLP)
                </h6>
                <span class="badge bg-light text-secondary border">Toxic-BERT</span>
            </div>
            <div class="card-body p-4 d-flex align-items-center justify-content-center" style="min-height: 320px;">
                <canvas id="sentimentChart" style="max-height: 280px;"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-clock-history text-primary me-2"></i>Son Eklenen Bloglar
                </h6>
                <a asp-area="Admin" asp-controller="Blog" asp-action="Index" class="btn btn-link text-primary p-0 small text-decoration-none">Tümünü Gör</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Görsel</th>
                                <th>Başlık</th>
                                <th>Kategori</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentBlogs.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">Henüz blog eklenmemiş.</td></tr>
                            }
                            else
                            {
                                @foreach (var blog in Model.RecentBlogs)
                                {
                                    <tr>
                                        <td style="width: 50px;">
                                            <img src="@(blog.CoverImage ?? "/blogy-1.0.0/images/hero_1.jpg")" alt="@blog.Title" class="rounded object-fit-cover" style="width: 45px; height: 35px;" />
                                        </td>
                                        <td>
                                            <span class="fw-semibold text-dark small d-inline-block text-truncate" style="max-width: 220px;">@blog.Title</span>
                                        </td>
                                        <td>
                                            <span class="badge bg-light text-dark border small">@(blog.CategoryName ?? "Genel")</span>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm border-0 rounded-3 h-100">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <h6 class="card-title mb-0 fw-bold text-dark">
                    <i class="bi bi-chat-left-quote-fill text-warning me-2"></i>Son Yorumlar & NLP Durumu
                </h6>
                <a asp-area="Admin" asp-controller="Comment" asp-action="Index" class="btn btn-link text-primary p-0 small text-decoration-none">Tümünü Gör</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kullanıcı</th>
                                <th>Yorum</th>
                                <th class="text-center">Durum</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.RecentComments.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted py-4">Henüz yorum yapılmamış.</td></tr>
                            }
                            else
                            {
                                @foreach (var comment in Model.RecentComments)
                                {
                                    <tr>
                                        <td class="small fw-semibold text-dark" style="width: 120px;">
                                            @(comment.User?.FullName ?? "Anonim")
                                        </td>
                                        <td>
                                            <span class="text-secondary small d-inline-block text-truncate" style="max-width: 200px;">@comment.Content</span>
                                        </td>
                                        <td class="text-center" style="width: 110px;">
                                            @if (comment.IsToxic)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger small">Toksik</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success small">Temiz</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. GRAFİK: Kategori Dağılımı (Doughnut Chart)
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryLabels));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CategoryBlogCounts));

            const catCtx = document.getElementById('categoryChart').getContext('2d');
            new Chart(catCtx, {
                type: 'doughnut',
                data: {
                    labels: catLabels.length ? catLabels : ['Henüz Kategori Yok'],
                    datasets: [{
                        data: catData.length ? catData : [1],
                        backgroundColor: [
                            '#3b82f6', '#10b981', '#f59e0b', '#ef4444',
                            '#8b5cf6', '#ec4899', '#06b6d4', '#64748b'
                        ],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });

            // 2. GRAFİK: Yorum Sağlığı (Temiz vs Toksik) (Pie Chart)
            const cleanCount = @Model.CleanCommentCount;
            const toxicCount = @Model.ToxicCommentCount;

            const sentCtx = document.getElementById('sentimentChart').getContext('2d');
            new Chart(sentCtx, {
                type: 'pie',
                data: {
                    labels: ['Temiz Yorumlar', 'Toksik Yorumlar (Engellenen)'],
                    datasets: [{
                        data: [cleanCount, toxicCount],
                        backgroundColor: ['#10b981', '#ef4444'],
                        borderWidth: 2,
                        borderColor: '#ffffff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' }
                    }
                }
            });
        });
    </script>
}
