@model List<AppRole>
@{
    ViewData["Title"] = "Rol Yönetimi";
    Layout = "_PanelLayout";
    int count = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Rol Listesi</h2>
        <p class="text-muted small mb-0">Sistemdeki yetki ve kullanıcı rollerini buradan yönetebilirsiniz.</p>
    </div>
    <a asp-area="Admin"
       asp-controller="Role"
       asp-action="Create"
       class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle"></i>
        <span>Yeni Rol Oluştur</span>
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 80px;" class="text-center">#</th>
                        <th>Rol Adı</th>
                        <th style="width: 220px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">
                                <i class="bi bi-shield-x fs-3 d-block mb-2"></i>
                                Henüz tanımlanmış bir rol bulunamadı.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            count++;
                            <tr>

                                <td class="text-center fw-bold text-muted">
                                    @count
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fs-6">
                                            @item.Name
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <div class="d-flex justify-content-center gap-2">

                                        <a asp-area="Admin"
                                           asp-controller="Role"
                                           asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            Düzenle
                                        </a>

                                        <form asp-area="Admin"
                                              asp-controller="Role"
                                              asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('@item.Name rolünü silmek istediğinize emin misiniz?');">

                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
