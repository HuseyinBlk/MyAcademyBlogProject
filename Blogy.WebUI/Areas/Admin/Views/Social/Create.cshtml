@model CreateSocialDto

@{
    ViewData["Title"] = "Yeni Sosyal Medya Ekle";
    Layout = "_PanelLayout";
}

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom">
                <h5 class="card-title mb-0 fw-bold">Yeni Sosyal Medya Hesabı Ekle</h5>
            </div>
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">Platform Adı</label>
                        <input asp-for="Name" class="form-control" placeholder="Örn: Instagram, Twitter, LinkedIn" required />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Url" class="form-label fw-semibold">Profil / Kanal Linki</label>
                        <input asp-for="Url" class="form-control" placeholder="https://instagram.com/kullaniciadi" required />
                        <span asp-validation-for="Url" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Icon" class="form-label fw-semibold">İkon Sınıfı</label>
                        <input asp-for="Icon" class="form-control" placeholder="Örn: icon-instagram, icon-twitter, icon-facebook" required />
                        <span asp-validation-for="Icon" class="text-danger small"></span>
                        <div class="form-text small">
                            Tema ikonları: <code>icon-instagram</code>, <code>icon-twitter</code>, <code>icon-facebook</code>, <code>icon-linkedin</code>, <code>icon-youtube-play</code>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-area="Admin" asp-controller="Social" asp-action="Index" class="btn btn-outline-secondary px-4">Vazgeç</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
