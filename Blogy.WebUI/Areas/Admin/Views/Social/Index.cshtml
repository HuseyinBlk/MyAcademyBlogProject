@model List<ResultSocialDto>

@{
    ViewData["Title"] = "Sosyal Medya Yönetimi";
    Layout = "_PanelLayout";
    int count = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Sosyal Medya Hesapları</h3>
        <p class="text-muted small mb-0">Sitenin footer ve menüsündeki sosyal medya linklerini buradan yönetebilirsiniz.</p>
    </div>
    <a asp-area="Admin" asp-controller="Social" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill"></i> Yeni Hesap Ekle
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th>Platform / İsim</th>
                        <th>Yönlendirme Linki</th>
                        <th>İkon Sınıfı</th>
                        <th style="width: 150px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-share fs-1 d-block mb-2 text-secondary"></i>
                                Henüz kayıtlı bir sosyal medya hesabı bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td class="fw-semibold text-dark">@item.Name</td>
                                <td>
                                    <a href="@item.Url" target="_blank" class="text-decoration-none small text-truncate d-inline-block" style="max-width: 250px;">
                                        @item.Url <i class="bi bi-box-arrow-up-right ms-1"></i>
                                    </a>
                                </td>
                                <td><code>@item.Icon</code></td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-area="Admin" asp-controller="Social" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning" title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Social" asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu hesabı silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
