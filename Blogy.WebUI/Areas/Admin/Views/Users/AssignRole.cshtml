@model List<AssignRoleDto>

@{
    ViewData["Title"] = "Rol Ata";
    Layout = "_PanelLayout";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between">
                <div>
                    <h5 class="card-title mb-0 fw-bold">Kullanıcı Rollerini Düzenle</h5>
                    <small class="text-muted">Kullanıcı: <strong>@ViewBag.FullName</strong></small>
                </div>
            </div>

            <div class="card-body p-4">
                <form method="post">
                    <p class="text-muted small mb-3">Kullanıcıya tanımlamak istediğiniz yetkileri kutucukları işaretleyerek seçin:</p>

                    <div class="list-group mb-4">
                        @foreach (var item in Model)
                        {
                            <div class="list-group-item d-flex align-items-center justify-content-between p-3">
                                <div class="form-check form-switch mb-0">
                                    <input type="checkbox"
                                           name="selectedRoles"
                                           value="@item.RoleName"
                                           class="form-check-input fs-5"
                                           id="role_@item.Id"
                                           @(item.RoleExist ? "checked" : "") />

                                    <label class="form-check-label fw-semibold ms-2 pt-1" for="role_@item.Id">
                                        @item.RoleName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check2-circle me-1"></i> Rolleri Kaydet
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">
                            Vazgeç
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
