@using Microsoft.IdentityModel.Tokens
@model List<ResultUserDto>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_PanelLayout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1 fw-bold">Kullanıcı Listesi</h2>
        <p class="text-muted small mb-0">Sistemde kayıtlı olan tüm kullanıcıları ve yazarları buradan görebilirsiniz.</p>
    </div>

    <a asp-controller="Register" asp-action="Index" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-person-plus"></i>
        <span>Yeni Kullanıcı Ekle</span>
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 70px;" class="text-center">#</th>
                        <th>Kullanıcı Bilgisi</th>
                        <th>Kullanıcı Adı</th>
                        <th>E-Posta Adresi</th>
                        <th>Roller</th>
                        <th style="width: 150px;" class="text-center">Durum</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                <i class="bi bi-people fs-2 d-block mb-2"></i>
                                Sistemde henüz kayıtlı kullanıcı bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @for (var index = 0; index < Model.Count; index++)
                        {
                            var user = Model[index];

                            <tr>

                                <td class="text-center fw-bold text-muted">
                                    @(index + 1)
                                </td>

                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="rounded-circle bg-primary-subtle text-primary fw-bold d-flex align-items-center justify-content-center"
                                             style="width: 42px; height: 42px; font-size: 1.1rem;">
                                            @if (!string.IsNullOrEmpty(user.ProfilImageUrl))
                                            {
                                            <img src="@user.ProfilImageUrl" class="w-100 h-100 object-fit-cover"/>
                                            }
                                            else
                                            {
                                                <i class="bi bi-person-fill"></i>
                                            }
                                        </div>
                                        <div>
                                            <div class="fw-semibold text-dark">@user.FullName</div>
                                            <span class="text-muted small">Aktif Kullanıcı</span>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary px-3 py-2 fs-6">
                                        @@@user.UserName
                                    </span>
                                </td>

                                <td>
                                    <a href="mailto:@user.Email" class="text-decoration-none text-muted">
                                        <i class="bi bi-envelope me-1"></i> @user.Email
                                    </a>
                                </td>

                                <td>
                                    @if (user.Roles != null && user.Roles.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var role in user.Roles)
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">
                                                    @role
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Rol Yok</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Users" asp-action="AssignRole" asp-route-id="@user.Id" class="btn btn-warning text-white">Rol Ata</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
