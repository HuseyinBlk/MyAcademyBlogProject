@model List<ResultBlogDto>

@{
    ViewData["Title"] = "Bloglarım";
    Layout = "_PanelLayout";
    int count = 0;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold mb-1">Blog Yazılarım</h3>
        <p class="text-muted small mb-0">Platformda yayınladığınız yazılarınızı buradan yönetebilirsiniz.</p>
    </div>
    <a asp-area="Writer" asp-controller="Blog" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle-fill"></i> Yeni Blog Yaz
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;">#</th>
                        <th style="width: 100px;">Görsel</th>
                        <th>Başlık</th>
                        <th>Kategori</th>
                        <th style="width: 140px;" class="text-center">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model == null || !Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-journal-x fs-1 d-block mb-2 text-secondary"></i>
                                Henüz yayınlanmış bir blog yazınız bulunmuyor.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var blog in Model)
                        {
                            count++;
                            <tr>
                                <td>@count</td>
                                <td>
                                    <img src="@(blog.CoverImage ?? "/images/img_1_sq.jpg")" alt="@blog.Title" class="rounded object-fit-cover" style="width: 60px; height: 45px;">
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark">@blog.Title</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        @(blog.CategoryName ?? "Genel")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-controller="Blog" asp-action="Details" target="_blank" class="btn btn-sm btn-outline-info" title="Sitede Gör">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-area="Writer" asp-controller="Blog" asp-action="Edit" asp-route-id="@blog.Id" class="btn btn-sm btn-outline-warning" title="Düzenle">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-area="Writer" asp-controller="Blog" asp-action="Delete" asp-route-id="@blog.Id" method="post" onsubmit="return confirm('Bu blog yazısını silmek istediğinize emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
