@model AboutViewModel

@{
    ViewData["Title"] = "Hakkımızda";
    Layout = "/Views/UiLayout/Layout.cshtml";
}

<div class="site-cover site-cover-sm same-height overlay single-page" style="background-image: url('/blogy-1.0.0/images/hero_5.jpg');">
    <div class="container">
        <div class="row same-height justify-content-center">
            <div class="col-md-6">
                <div class="post-entry text-center">
                    <h1 class="mb-4">Hakkımızda</h1>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section sec-halfs py-0">
    <div class="container">

        <div class="half-content d-lg-flex align-items-stretch">
            <div class="img" style="background-image: url('@(Model.About?.ImageUrl1 ?? "/blogy-1.0.0/images/hero_1.jpg")')" data-aos="fade-in" data-aos-delay="100">
            </div>
            <div class="text">
                <h2 class="heading text-primary mb-3">@(Model.About?.Title1 ?? "Üreticiler ve Yaratıcı Zihinler İçin Kaynaklar")</h2>
                <p class="mb-4">
                    @(Model.About?.Description1 ?? "Blogy, teknoloji, yazılım, tasarım ve modern kültür dünyasından derinlemesine analizleri okuyucularıyla buluşturmayı amaçlayan bağımsız bir bilgi platformudur.")
                </p>
                <p><a href="/Blog/Index" class="btn btn-outline-primary py-2">Yazıları Keşfet</a></p>
            </div>
        </div>

        <div class="half-content d-lg-flex align-items-stretch">
            <div class="img order-md-2" style="background-image: url('@(Model.About?.ImageUrl2 ?? "/blogy-1.0.0/images/hero_2.jpg")')" data-aos="fade-in">
            </div>
            <div class="text">
                <h2 class="heading text-primary mb-3">@(Model.About?.Title2 ?? "Binlerce Okuyucu Tarafından Güvenle Takip Ediliyoruz")</h2>
                <p class="mb-4">
                    @(Model.About?.Description2 ?? "Her gün büyüyen yazar topluluğumuzla bilginin gücüne inanıyor, deneyim ve uzmanlığı herkes için erişilebilir hale getiriyoruz.")
                </p>
                <p><a href="/Contact/Index" class="btn btn-outline-primary py-2">Bize Ulaşın</a></p>
            </div>
        </div>
    </div>
</div>

<div class="section sec-features">
    <div class="container">
        <div class="row g-5">
            <div class="col-12 col-sm-6 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="0">
                <div class="feature d-flex">
                    <span class="bi-bag-check-fill"></span>
                    <div>
                        <h3>@(Model.About?.FeatureTitle1 ?? "Modern Mimari & Yazılım")</h3>
                        <p>@(Model.About?.FeatureDescription1 ?? "En güncel teknolojiler, kodlama pratikleri ve yazılım dünyasından kaliteli rehberler.")</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="100">
                <div class="feature d-flex">
                    <span class="bi-wallet-fill"></span>
                    <div>
                        <h3>@(Model.About?.FeatureTitle2 ?? "Özgün Fikirler & Kültür")</h3>
                        <p>@(Model.About?.FeatureDescription2 ?? "Farklı bakış açıları kazandıran yenilikçi, yaratıcı ve derinlemesine makaleler.")</p>
                    </div>
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-6 col-lg-4" data-aos="fade-up" data-aos-delay="200">
                <div class="feature d-flex">
                    <span class="bi-pie-chart-fill"></span>
                    <div>
                        <h3>@(Model.About?.FeatureTitle3 ?? "Güçlü Yazar Topluluğu")</h3>
                        <p>@(Model.About?.FeatureDescription3 ?? "Bilgi paylaşmayı seven, sürekli üreten ve okuyucularıyla etkileşim kuran dinamik ekip.")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row mb-5">
            <div class="col-lg-5 mx-auto text-center" data-aos="fade-up">
                <h2 class="heading text-primary">En Çok Etkileşimli Yazarlarımız</h2>
                <p>Blogy platformunda en fazla içerik üreten ve topluluğa değer katan öne çıkan yazarlarımız.</p>
            </div>
        </div>

        <div class="row">
            @if (Model.TopWriters != null && Model.TopWriters.Any())
            {
                int delay = 0;
                foreach (var writer in Model.TopWriters)
                {
                    <div class="col-lg-4 mb-4 text-center" data-aos="fade-up" data-aos-delay="@delay">

                        <img src="@(string.IsNullOrEmpty(writer.ProfilImageUrl) ? "/blogy-1.0.0/images/person_1.jpg" : writer.ProfilImageUrl)"
                             alt="@writer.FullName"
                             class="img-fluid w-50 rounded-circle mb-3"
                             style="aspect-ratio: 1/1; object-fit: cover;">
                        <h5 class="text-black mb-1">@writer.FullName</h5>
                        <p class="text-muted small mb-2">@(writer.Title ?? "Blogy Yazarı")</p>
                        <span class="badge bg-primary px-3 py-1 rounded-pill">
                            <i class="bi bi-journal-text me-1"></i> @writer.BlogCount Yazı
                        </span>
                    </div>
                    delay = (delay + 100) % 300;
                }
            }
            else
            {
                <div class="col-12 text-center text-muted">
                    <p>Henüz aktif yazar bulunmamaktadır.</p>
                </div>
            }
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row justify-content-between">
            <div class="col-lg-7 mb-4 mb-lg-0">
                <img src="@(Model.About?.BottomImageUrl ?? "/blogy-1.0.0/images/img_7_sq.jpg")" alt="Blogy Vizyon" class="img-fluid rounded">
            </div>
            <div class="col-lg-4 ps-lg-2">
                <div class="mb-5">
                    <h2 class="text-black h4">@(Model.About?.BottomTitle ?? "Profesyonel Yazarlar İçin Yayıncılık Platformu")</h2>
                    <p>
                        @(Model.About?.Description1 ?? "Blogy, yapay zeka entegrasyonları ve modern yazarlık araçlarıyla kullanıcılarına eşsiz bir dijital yayıncılık deneyimi sunar.")
                    </p>
                </div>
                <div class="d-flex mb-3 service-alt">
                    <div>
                        <span class="bi-wallet-fill me-4"></span>
                    </div>
                    <div>
                        <h3>Blogunuzu Oluşturun</h3>
                        <p>Zengin metin editörleri ve yapay zeka asistanıyla dakikalar içinde profesyonel makaleler hazırlayın.</p>
                    </div>
                </div>

                <div class="d-flex mb-3 service-alt">
                    <div>
                        <span class="bi-pie-chart-fill me-4"></span>
                    </div>
                    <div>
                        <h3>Kaynaklar ve İçgörüler</h3>
                        <p>Veriye dayalı analizler, yazar istatistikleri ve zengin kategori filtreleriyle hedef kitlenize ulaşın.</p>
                    </div>
                </div>

                <div class="d-flex mb-3 service-alt">
                    <div>
                        <span class="bi-bag-check-fill me-4"></span>
                    </div>
                    <div>
                        <h3>Toplulukla Büyüyün</h3>
                        <p>Yorumlar, geri bildirimler ve etkileşimli araçlarla okuyucularınızla doğrudan iletişimde kalın.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
