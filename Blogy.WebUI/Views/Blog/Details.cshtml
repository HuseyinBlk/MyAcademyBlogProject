@model ResultBlogDto

@{
    ViewBag.Title = "title";
    Layout = "/Views/UiLayout/Layout.cshtml";
}

  <div class="site-cover site-cover-sm same-height overlay single-page" style="background-image: url('@Model.CoverImage');">
    <div class="container">
      <div class="row same-height justify-content-center">
        <div class="col-md-6">
          <div class="post-entry text-center">
            <h1 class="mb-4">@Model.Title</h1>
            <div class="post-meta align-items-center text-center">
              <figure class="author-figure mb-0 me-3 d-inline-block"><img src="@Model.Writer.ProfilImageUrl" alt="Image" class="img-fluid"></figure>
              <span class="d-inline-block mt-1">By @Model.Writer.FirstName @Model.Writer.LastName</span>
              <span>&nbsp;-&nbsp; @Model.CreatedOn</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <section class="section">
    <div class="container">

      <div class="row blog-entries element-animate">

        <div class="col-md-12 col-lg-8 main-content">

          <div class="post-content-body">
            <div class="row my-4">
              <div class="col-md-12 mb-4">
                <img src="@Model.CoverImage" alt="Image placeholder" class="img-fluid rounded">
              </div>
              <div class="col-md-6 mb-4">
                <img src="@Model.BlogImage" alt="Image placeholder" class="img-fluid rounded">
              </div>
              <div class="col-md-6 mb-4">
                <img src="@Model.BlogImage2" alt="Image placeholder" class="img-fluid rounded">
              </div>
            </div>
            <p>@Model.Description</p>
          </div>

          <div class="pt-5">
            <p>
              <strong>Kategori:</strong>
              <a asp-action="GetBlogsByCategory" asp-route-id="@Model.CategoryId" class="badge bg-primary text-decoration-none me-2">@Model.CategoryName</a>

              <strong class="ms-3">Etiketler:</strong>
              @foreach (var item in Model.BlogTags)
              {
                <a asp-controller="Blog"
                   asp-action="GetBlogsByTag"
                   asp-route-id="@item.TagId"
                   class="badge bg-light text-dark border text-decoration-none me-1">
                  #@item.Tag?.Name
                </a>
              }
            </p>
          </div>

          <div class="pt-5 comment-wrap">
            <h3 class="mb-5 heading">@Model.Comments.Count() Yorum</h3>
            <ul class="comment-list">
              @foreach (var item in Model.Comments.Where(x => !x.IsToxic))
              {

              <li class="comment">
                <div class="vcard">
                  <img src="@item.User.ProfilImageUrl" alt="Image placeholder">
                </div>
                <div class="comment-body">
                  <h3>@item.User.FirstName @item.User.LastName</h3>
                  <div class="meta">@item.CreatedOn</div>
                  <p>@item.Content</p>
                  <p><a href="#" class="reply rounded">Reply</a></p>
                </div>
              </li>
              }
            </ul>

            <div class="comment-form-wrap pt-5">
              <h3 class="mb-5">Bir Yorum Bırakın</h3>
              @if (User.Identity.IsAuthenticated)
              {
                <form asp-controller="Blog" asp-action="AddComment" method="post" class="p-4 bg-light rounded">

                  <input type="hidden" name="BlogId" value="@Model.Id" />
                  <div class="alert alert-info py-2 small mb-3">
                    <i class="bi bi-person-fill me-1"></i>
                    <strong>@User.Identity.Name</strong> olarak yorum yapıyorsunuz.
                  </div>
                  <div class="form-group mb-3">
                    <label for="message" class="form-label fw-semibold">Yorumunuz</label>
                    <textarea name="Content" id="message" cols="30" rows="5" class="form-control" placeholder="Düşüncelerinizi buraya yazın..." required></textarea>
                  </div>
                  <div class="form-group">
                    <button type="submit" class="btn btn-primary px-4">
                      <i class="bi bi-send-fill me-1"></i> Yorumu Gönder
                    </button>
                  </div>
                </form>
              }
              else
              {
                <div class="alert alert-warning text-center p-4 rounded shadow-sm">
                  <i class="bi bi-exclamation-circle-fill fs-2 text-warning d-block mb-2"></i>
                  <h5 class="fw-bold">Yorum Yapabilmek İçin Giriş Yapmalısınız</h5>
                  <p class="text-muted small mb-3">Bu blog yazısına fikirlerinizi yazabilmek için lütfen hesabınıza giriş yapın veya kayıt olun.</p>
                  <div class="d-flex justify-content-center gap-2">
                    <a asp-controller="Login" asp-action="Index" class="btn btn-primary btn-sm px-4">
                      Giriş Yap
                    </a>
                    <a asp-controller="Register" asp-action="Index" class="btn btn-outline-secondary btn-sm px-4">
                      Kayıt Ol
                    </a>
                  </div>
                </div>
              }
            </div>
          </div>

        </div>

        <div class="col-md-12 col-lg-4 sidebar">
          <div class="sidebar-box search-form-wrap">
            <form asp-controller="Blog" asp-action="Index" method="get" class="sidebar-search-form">
              <span class="bi-search"></span>
              <input type="text" name="search" class="form-control" id="s" placeholder="Blog ara ve Enter'a bas...">
            </form>
          </div>

          <div class="sidebar-box">
            <div class="bio text-center">
              <img src="@Model.Writer.ProfilImageUrl"
                   alt="@($"{Model.Writer.FirstName} {Model.Writer.LastName}")"
                   class="img-fluid rounded-circle mb-3 shadow-sm"
                   style="width: 120px; height: 120px; object-fit: cover;">

              <div class="bio-body">
                <h2 class="h4 mb-1">@(Model.Writer != null ? $"{Model.Writer.FirstName} {Model.Writer.LastName}" : "Blogy Yazarı")</h2>

                <p class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 mb-3">
                  @(Model.Writer?.Title ?? "İçerik Yazarı")
                </p>

                <p class="mb-3 text-muted small">
                  Blogy platformunda teknoloji, yazılım ve dijital dünyaya dair özgün içerikler üreten topluluk yazarımız.
                </p>

                @if (!string.IsNullOrEmpty(Model.Writer?.Email))
                {
                  <p>
                    <a href="mailto:@Model.Writer.Email" class="btn btn-outline-primary btn-sm rounded px-3 py-2">
                      <i class="bi bi-envelope me-1"></i> Yazara Ulaş
                    </a>
                  </p>
                }
              </div>
            </div>
          </div>

          @await Component.InvokeAsync("BlogsByCategoryLatestBlogsComponent")

          @await Component.InvokeAsync("CategoryListComponent")

          @await Component.InvokeAsync("TagListComponent")
        </div>

      </div>
    </div>
  </section>
