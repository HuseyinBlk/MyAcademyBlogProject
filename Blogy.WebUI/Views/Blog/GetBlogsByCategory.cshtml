@using PagedList.Core.Mvc
@model PagedList.Core.PagedList<ResultBlogDto>

@{
	ViewBag.Title = ViewBag.categoryName + " Blogları";
	Layout = "/Views/UiLayout/Layout.cshtml";
	var pagerOptions = new PagedListRenderOptions
	{
		DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
		DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
		LinkToPreviousPageFormat = "‹",
		LinkToNextPageFormat = "›"
	};
}

	<div class="section search-result-wrap">
		<div class="container">
			<div class="row">
				<div class="col-12">
					<div class="heading">Kategori: @ViewBag.categoryName</div>
				</div>
			</div>
			<div class="row posts-entry">
				<div class="col-lg-8">
					@foreach (var item in Model)
					{
						var description = item.Description ?? string.Empty;

						var summary = description.Length > 100
							? description[..100] + "..."
							: description;

						<div class="blog-entry d-flex blog-entry-search-item">
							<a asp-controller="Blog"
							   asp-action="Details"
							   asp-route-id="@item.Id"
							   class="img-link me-4 flex-shrink-0 overflow-hidden rounded"
							   style="width: 220px; height: 150px;">

								<img src="@item.CoverImage"
								     alt="@item.Title"
								     class="w-100 h-100 object-fit-cover"/>
							</a>
							<div>
								<span class="date">@item.CreatedOn &bullet; <a href="#">@ViewBag.categoryName</a></span>
								<h2><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></h2>
								<p>@summary</p>
								<p><a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Oku</a></p>
							</div>
						</div>
					}

					<div class="row text-start pt-5 border-top">
						<div class="col-md-12">
							<div class="custom-pagination">
								<pager list="@Model"
								       asp-controller="Blog"
								       asp-action="GetBlogsByCategory"
								       asp-route-id="@ViewBag.categoryId"
								       param-page-number="pageNumber"
								       options="@pagerOptions" />
							</div>
						</div>
					</div>

				</div>

				<div class="col-lg-4 sidebar">

					<div class="sidebar-box search-form-wrap mb-4">
						<form asp-controller="Blog" asp-action="Index" method="get" class="sidebar-search-form">
							<span class="bi-search"></span>
							<input type="text" name="search" class="form-control" id="s" placeholder="Blog ara ve Enter'a bas...">
						</form>
					</div>

					@await Component.InvokeAsync("BlogsByCategoryLatestBlogsComponent")

					@await Component.InvokeAsync("CategoryListComponent")

					@await Component.InvokeAsync("TagListComponent")

				</div>
			</div>
		</div>
	</div>
