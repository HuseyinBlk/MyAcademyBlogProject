@using PagedList.Core.Mvc
@model PagedList.Core.PagedList<ResultBlogDto>

@{
    ViewBag.Title = "title";
    Layout = "/Views/UiLayout/Layout.cshtml";
    var pagerOptions = new PagedListRenderOptions
    {
      DisplayLinkToFirstPage = PagedListDisplayMode.IfNeeded,
      DisplayLinkToLastPage = PagedListDisplayMode.IfNeeded,
      LinkToPreviousPageFormat = "‹",
      LinkToNextPageFormat = "›"
    };
}

  <div class="hero overlay inner-page bg-primary py-5">
    <div class="container">
      <div class="row align-items-center justify-content-center text-center pt-5">
        <div class="col-lg-6">
          <h1 class="heading text-white mb-3" data-aos="fade-up">Blog</h1>
        </div>
      </div>
    </div>
  </div>

  @if (!string.IsNullOrEmpty(ViewBag.Search as string))
  {
    <div class="alert alert-info text-center my-3">
      <i class="bi bi-search me-1"></i> "<strong>@ViewBag.Search</strong>" için arama sonuçları gösteriliyor.
      <a asp-action="Index" class="ms-2 text-decoration-none badge bg-secondary">Aramayı Temizle</a>
    </div>
  }

  <div class="section search-result-wrap">
    <div class="container">

      <div class="row posts-entry">
        <div class="col-lg-8">

          @foreach (var item in Model)
          {
              var rawDesc = System.Text.RegularExpressions.Regex.Replace(item.Description ?? string.Empty, "<.*?>", string.Empty);
              var summary = rawDesc.Length > 140 ? rawDesc.Substring(0, 140) + "..." : rawDesc;

              <div class="blog-entry d-flex blog-entry-search-item align-items-center mb-4 pb-4 border-bottom">

                <a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id"
                   class="img-link me-4 flex-shrink-0 overflow-hidden rounded shadow-sm"
                   style="width: 230px; height: 150px; min-width: 230px;">
                  <img src="@(string.IsNullOrEmpty(item.CoverImage) ? "/blogy-1.0.0/images/hero_1.jpg" : item.CoverImage)"
                       alt="@item.Title"
                       class="w-100 h-100 object-fit-cover">
                </a>

                <div class="flex-grow-1">
                  <span class="date text-muted small">
                    <i class="bi bi-calendar3 me-1"></i>@(item.CreatedOn?.ToString("dd MMM yyyy") ?? DateTime.Now.ToString("dd MMM yyyy")) &bullet;
                    <a asp-controller="Blog" asp-action="GetBlogsByCategory" asp-route-id="@item.CategoryId" class="text-primary fw-semibold text-decoration-none">
                      @item.CategoryName
                    </a>
                  </span>

                  <h2 class="mt-1 mb-2 fs-5 fw-bold">
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id" class="text-dark text-decoration-none">
                      @item.Title
                    </a>
                  </h2>

                  <p class="text-secondary small mb-3" style="line-height: 1.6;">@summary</p>

                  <p class="mb-0">
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1">
                      Devamını Oku <i class="bi bi-arrow-right"></i>
                    </a>
                  </p>
                </div>
              </div>
          }

          <div class="row text-start pt-5 border-top">
            <div class="col-md-12">
              <div class="custom-pagination">
                <pager list="@Model"
                       asp-controller="Blog"
                       asp-action="Index"
                       asp-route-search="@ViewBag.Search"
                       param-page-number="pageNumber"
                       options="@pagerOptions" />
              </div>
            </div>
          </div>

        </div>

        <div class="col-lg-4 sidebar">

          <div class="sidebar-box search-form-wrap mb-4">
            <form asp-controller="Blog" asp-action="Index" method="get" class="sidebar-search-form">
              <span class="bi-search"></span>
              <input type="text" name="search" value="@ViewBag.Search" class="form-control" id="s" placeholder="Blog ara ve Enter'a bas...">
            </form>
          </div>

          @await Component.InvokeAsync("BlogsByCategoryLatestBlogsComponent")

          @await Component.InvokeAsync("CategoryListComponent")

          @await Component.InvokeAsync("TagListComponent")

        </div>
      </div>
    </div>
  </div>
