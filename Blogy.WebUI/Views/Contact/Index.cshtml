@model CreateContactDto

@{
    ViewData["Title"] = "İletişim";
    Layout = "/Views/UiLayout/Layout.cshtml";
}

<div class="hero overlay inner-page bg-primary py-5">
    <div class="container">
        <div class="row align-items-center justify-content-center text-center pt-5">
            <div class="col-lg-6">
                <h1 class="heading text-white mb-3" data-aos="fade-up">Bize Ulaşın</h1>
                <p class="text-white-50">Sorularınız, önerileriniz veya iş birlikleriniz için bize bir mesaj bırakabilirsiniz.</p>
            </div>
        </div>
    </div>
</div>

<div class="section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                <div class="card shadow-sm border-0 p-4 p-md-5 rounded-4">
                    <h3 class="fw-bold mb-4">Bir Mesaj Gönderin</h3>

                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3"></div>

                        <div class="row g-3">

                            <div class="col-md-6 mb-3">
                                <label asp-for="Name" class="form-label fw-semibold">Adınız ve Soyadınız <span class="text-danger">*</span></label>
                                <input type="text" asp-for="Name" class="form-control" placeholder="Ad Soyad" required />
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label fw-semibold">E-Posta Adresiniz <span class="text-danger">*</span></label>
                                <input type="email" asp-for="Email" class="form-control" placeholder="ornek@email.com" required />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-3">
                                <label asp-for="Subject" class="form-label fw-semibold">Mesaj Konusu <span class="text-danger">*</span></label>
                                <input type="text" asp-for="Subject" class="form-control" placeholder="Hangi konuda yazıyorsunuz?" required />
                                <span asp-validation-for="Subject" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-4">
                                <label asp-for="Message" class="form-label fw-semibold">Mesajınız <span class="text-danger">*</span></label>
                                <textarea asp-for="Message" class="form-control" rows="6" placeholder="Mesajınızı buraya yazın..." required></textarea>
                                <span asp-validation-for="Message" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <button type="submit" class="btn btn-primary px-5 py-2 fw-semibold rounded-pill">
                                    <i class="bi bi-send-fill me-1"></i> Mesajı Gönder
                                </button>
                            </div>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>
