@{
    ViewData["Title"] = "Erişim Reddedildi - 403";
    Layout = "/Views/UiLayout/Layout.cshtml";
}

<div class="section py-5 my-5">
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-6 col-md-8">

                <div class="card shadow border-0 p-5 rounded-4">

                    <div class="mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle text-danger rounded-circle" style="width: 90px; height: 90px;">
                            <i class="bi bi-shield-lock-fill" style="font-size: 3rem;"></i>
                        </div>
                    </div>

                    <h2 class="fw-bold text-dark mb-2">Erişim Engellendi!</h2>
                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2 mb-3 align-self-center">
                        Hata Kodu: 403 - Yetkisiz Giriş
                    </span>

                    <p class="text-secondary mb-4">
                        Üzgünüz, görüntülemeye çalıştığınız sayfaya erişim yetkiniz bulunmamaktadır.
                        Bu alan sadece belirli kullanıcı rollerine (Admin/Yazar) özeldir.
                    </p>

                    <div class="d-flex justify-content-center gap-2">
                        <a asp-controller="Blog" asp-action="Index" class="btn btn-primary px-4 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-house-door-fill me-1"></i> Ana Sayfaya Dön
                        </a>
                        <a asp-controller="Login" asp-action="Logout" class="btn btn-outline-danger px-4 py-2 rounded-pill fw-semibold">
                            <i class="bi bi-box-arrow-right me-1"></i> Farklı Hesapla Gir
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
