@model List<ResultBlogDto>

@if (Model != null && Model.Count >= 5)
{
    <section class="section bg-light">
        <div class="container">
            <div class="row align-items-stretch retro-layout">

                <div class="col-md-4">
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model[0].Id" class="h-entry mb-30 v-height gradient">
                        <div class="featured-img" style="background-image: url('@Model[0].CoverImage');"></div>
                        <div class="text">
                            <span class="date">@(Model[0].CreatedOn?.ToString("dd MMM yyyy") ?? "-")</span>
                            <h2>@Model[0].Title</h2>
                        </div>
                    </a>
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model[1].Id" class="h-entry v-height gradient">
                        <div class="featured-img" style="background-image: url('@Model[1].CoverImage');"></div>
                        <div class="text">
                            <span class="date">@(Model[1].CreatedOn?.ToString("dd MMM yyyy") ?? "-")</span>
                            <h2>@Model[1].Title</h2>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model[2].Id" class="h-entry img-5 h-100 gradient">
                        <div class="featured-img" style="background-image: url('@Model[2].CoverImage');"></div>
                        <div class="text">
                            <span class="date">@(Model[2].CreatedOn?.ToString("dd MMM yyyy") ?? "-")</span>
                            <h2>@Model[2].Title</h2>
                        </div>
                    </a>
                </div>

                <div class="col-md-4">
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model[3].Id" class="h-entry mb-30 v-height gradient">
                        <div class="featured-img" style="background-image: url('@Model[3].CoverImage');"></div>
                        <div class="text">
                            <span class="date">@(Model[3].CreatedOn?.ToString("dd MMM yyyy") ?? "-")</span>
                            <h2>@Model[3].Title</h2>
                        </div>
                    </a>
                    <a asp-controller="Blog" asp-action="Details" asp-route-id="@Model[4].Id" class="h-entry v-height gradient">
                        <div class="featured-img" style="background-image: url('@Model[4].CoverImage');"></div>
                        <div class="text">
                            <span class="date">@(Model[4].CreatedOn?.ToString("dd MMM yyyy") ?? "-")</span>
                            <h2>@Model[4].Title</h2>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </section>
}
