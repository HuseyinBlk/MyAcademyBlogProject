@model dynamic

@{
    Layout = null;
}

<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="author" content="Untree.co">
	<link rel="shortcut icon" href="favicon.png">

	<meta name="description" content="" />
	<meta name="keywords" content="bootstrap, bootstrap5" />

	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;600;700&display=swap" rel="stylesheet">

	<link rel="stylesheet" href="~/blogy-1.0.0/fonts/icomoon/style.css">
	<link rel="stylesheet" href="~/blogy-1.0.0/fonts/flaticon/font/flaticon.css">

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">

	<link rel="stylesheet" href="~/blogy-1.0.0/css/tiny-slider.css">
	<link rel="stylesheet" href="~/blogy-1.0.0/css/aos.css">
	<link rel="stylesheet" href="~/blogy-1.0.0/css/glightbox.min.css">
	<link rel="stylesheet" href="~/blogy-1.0.0/css/style.css">

	<link rel="stylesheet" href="~/blogy-1.0.0/css/flatpickr.min.css">

	<title>Blogy &mdash; Free Bootstrap 5 Website Template by Untree.co</title>
</head>
<body>

	<div class="site-mobile-menu site-navbar-target">
		<div class="site-mobile-menu-header">
			<div class="site-mobile-menu-close">
				<span class="icofont-close js-menu-toggle"></span>
			</div>
		</div>
		<div class="site-mobile-menu-body"></div>
	</div>

	<nav class="site-nav">
		<div class="container">
			<div class="menu-bg-wrap">
				<div class="site-navigation">
					<div class="row g-0 align-items-center">
						<div class="col-2">
							<a asp-controller="Blog" asp-action="Index" class="logo m-0 float-start">Blogy<span class="text-primary">.</span></a>
						</div>
						<div class="col-8 text-center">
							<form asp-controller="Blog" asp-action="Index" method="get" class="search-form d-inline-block d-lg-none">
								<input type="text" name="search" class="form-control" placeholder="Blog ara..." value="@ViewBag.Search">
								<span class="bi-search"></span>
							</form>

							<ul class="js-clone-nav d-none d-lg-inline-block text-start site-menu mx-auto">
								<li class="active"><a asp-controller="Default" asp-action="Index">Ana Sayfa</a></li>
								<li><a asp-controller="About" asp-action="Index">Hakkımızda</a></li>
								<li><a asp-controller="Blog" asp-action="Index">Bloglar</a></li>
								<li><a asp-controller="Contact" asp-action="Index">İletişim</a></li>
								@if (User.Identity.IsAuthenticated)
								{
									<li class="has-children">
										<a href="#">
											<i class="bi bi-person-circle me-1"></i> @User.Identity.Name
										</a>
										<ul class="dropdown">
											@if (User.IsInRole(Roles.Admin))
											{
												<li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Paneli</a></li>
											}
											@if (User.IsInRole(Roles.Writer))
											{
												<li><a asp-area="Writer" asp-controller="Blog" asp-action="Index">Yazar Paneli</a></li>
											}
											@if (User.IsInRole(Roles.User))
											{
												<li><a asp-area="User" asp-controller="Profile" asp-action="Index">Profilim</a></li>
											}
											<li><hr class="dropdown-divider"></li>
											<li><a asp-controller="Login" asp-action="Logout" class="text-danger">Çıkış Yap</a></li>
										</ul>
									</li>
								}
								else
								{
									<li>
										<a asp-controller="Login" asp-action="Index">
											<i class="bi bi-box-arrow-in-right me-1"></i> Giriş Yap
										</a>
									</li>
									<li>
										<a asp-controller="Register" asp-action="Index">
											Kayıt Ol
										</a>
									</li>
								}
							</ul>
						</div>
						<div class="col-2 text-end">
							<a href="#" class="burger ms-auto float-end site-menu-toggle js-menu-toggle d-inline-block d-lg-none light">
								<span></span>
							</a>
							<form asp-controller="Blog" asp-action="Index" method="get" class="search-form d-none d-lg-inline-block">
								<input type="text" name="search" class="form-control" placeholder="Blog ara..." value="@ViewBag.Search">
								<span class="bi-search"></span>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>
	</nav>

	@RenderBody()

	<footer class="site-footer">
		<div class="container">
			<div class="row">
				<div class="col-lg-4">
					@await Component.InvokeAsync("UIFooterAboutComponent")
					@await Component.InvokeAsync("UIFooterSocialComponent")
				</div>
				<div class="col-lg-4 ps-lg-5">
					<div class="widget">
						<h3 class="mb-4">Hızlı Bağlantılar</h3>
						<ul class="list-unstyled float-start links">
							<li><a asp-controller="Default" asp-action="Index">Ana Sayfa</a></li>
							<li><a asp-controller="Blog" asp-action="Index">Tüm Yazılar</a></li>
							<li><a asp-controller="About" asp-action="Index">Hakkımızda</a></li>
							<li><a asp-controller="Contact" asp-action="Index">İletişim</a></li>
						</ul>
						<ul class="list-unstyled float-start links">
							<li><a asp-controller="Login" asp-action="Index">Giriş Yap</a></li>
							<li><a asp-controller="Register" asp-action="Index">Kayıt Ol</a></li>
							<li><a asp-area="Writer" asp-controller="Blog" asp-action="Index">Yazar Paneli</a></li>
							<li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Paneli</a></li>
						</ul>
					</div>
				</div>
				<div class="col-lg-4">
						@await Component.InvokeAsync("UIFooterRecentBlogsComponent")

				</div>
			</div>

			<div class="row mt-5">
				<div class="col-12 text-center">

            <p>Copyright &copy;<script>document.write(new Date().getFullYear());</script>. All Rights Reserved. &mdash; Designed with love by <a href="https://untree.co">Untree.co</a>  Distributed by <a href="https://themewagon.com">ThemeWagon</a>
            </p>
          </div>
        </div>
      </div>
    </footer>

    <div id="overlayer"></div>
    <div class="loader">
    	<div class="spinner-border text-primary" role="status">
    		<span class="visually-hidden">Loading...</span>
    	</div>
    </div>

    <script src="~/blogy-1.0.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/blogy-1.0.0/js/tiny-slider.js"></script>

    <script src="~/blogy-1.0.0/js/flatpickr.min.js"></script>

    <script src="~/blogy-1.0.0/js/aos.js"></script>
    <script src="~/blogy-1.0.0/js/glightbox.min.js"></script>
    <script src="~/blogy-1.0.0/js/navbar.js"></script>
    <script src="~/blogy-1.0.0/js/counter.js"></script>
    <script src="~/blogy-1.0.0/js/custom.js"></script>

  </body>
  </html>
